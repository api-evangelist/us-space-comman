          "id": "f32dd7b0-7bd1-4a04-be08-191d09072e9a",
          "name": "List Conjunction Data Messages (CDM)",
          "request": {
            "name": "List Conjunction Data Messages (CDM)",
            "description": {
              "content": "Returns publicly available Conjunction Data Messages (CDMs), which are notifications of potential close approaches between tracked objects. Sorted by collision probability descending.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "basicspacedata",
                "query",
                "class",
                "cdm_public",
                "format",
                ":format"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "SAT_1_ID",
                  "value": "<string>",
                  "description": "NORAD ID of primary object"
                },
                {
                  "disabled": false,
                  "key": "SAT_2_ID",
                  "value": "<string>",
                  "description": "NORAD ID of secondary object"
                },
                {
                  "disabled": false,
                  "key": "TCA_RANGE_START",
                  "value": "<string>",
                  "description": "Time of closest approach start filter (ISO 8601)"
                },
                {
                  "disabled": false,
                  "key": "TCA_RANGE_END",
                  "value": "<string>",
                  "description": "Time of closest approach end filter (ISO 8601)"
                },
                {
                  "disabled": false,
                  "key": "PC",
                  "value": "<string>",
                  "description": "Probability of collision filter (e.g., >0.0001)"
                },
                {
                  "disabled": false,
                  "key": "MISS_DISTANCE",
                  "value": "<string>",
                  "description": "Miss distance filter (km)"
                },
                {
                  "disabled": false,
                  "key": "orderby",
                  "value": "<string>"
                },
                {
                  "disabled": false,
                  "key": "limit",
                  "value": "<integer>"
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "json",
                  "key": "format",
                  "description": "(Required) "
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
          },
