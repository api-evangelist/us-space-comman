          "request": {
            "name": "List Current General Perturbation Orbital Elements",
            "description": {
              "content": "Returns the latest orbital element sets (GP/TLEs) for tracked objects. The GP class provides the newest element set per object.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "basicspacedata",
                "query",
                "class",
                "gp",
                "format",
                ":format"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "NORAD_CAT_ID",
                  "value": "<string>",
                  "description": "NORAD catalog number (e.g., 25544 for ISS)"
                },
                {
                  "disabled": false,
                  "key": "OBJECT_NAME",
                  "value": "<string>",
                  "description": "Object name (supports wildcard ~~)"
                },
                {
                  "disabled": false,
                  "key": "EPOCH",
                  "value": "<string>",
                  "description": "Epoch filter (e.g., >now-30 for last 30 days)"
                },
                {
                  "disabled": false,
                  "key": "DECAY_DATE",
                  "value": "<string>",
                  "description": "Filter for active (null-val) or decayed objects"
                },
                {
                  "disabled": false,
                  "key": "INCLINATION",
                  "value": "<string>",
                  "description": "Orbital inclination filter"
                },
                {
                  "disabled": false,
                  "key": "PERIOD",
                  "value": "<string>",
                  "description": "Orbital period filter (minutes)"
                },
                {
                  "disabled": false,
                  "key": "APOGEE",
                  "value": "<string>",
                  "description": "Apogee altitude filter (km)"
                },
                {
                  "disabled": false,
                  "key": "PERIGEE",
                  "value": "<string>",
                  "description": "Perigee altitude filter (km)"
                },
                {
                  "disabled": false,
                  "key": "COUNTRY_CODE",
                  "value": "<string>",
                  "description": "ISO country code of object owner"
                },
                {
                  "disabled": false,
                  "key": "orderby",
                  "value": "<string>",
                  "description": "Sort field and direction (e.g., NORAD_CAT_ID asc)"
                },
                {
                  "disabled": false,
                  "key": "limit",
                  "value": "<integer>",
                  "description": "Max number of results"
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "json",
                  "key": "format",
                  "description": "(Required) Response format"
                }
